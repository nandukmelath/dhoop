{
  "name": "dhoop",
  "version": "0.1.0",
  "description": "Dhoop: a voice guide that surveys your roof for solar and walks you through the government subsidy. Built on Agora Conversational AI and Murf Falcon.",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "verify:api": "DHOOP_NO_PERSIST=1 node --import tsx scripts/verify-api-contracts.ts",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run test:dhoop && npm run build",
    "test:dhoop": "DHOOP_NO_PERSIST=1 node --import tsx --test scripts/test-dhoop.ts",
    "show:agent": "DHOOP_NO_PERSIST=1 node --import tsx scripts/show-agent-config.ts",
    "smoke": "node --import tsx scripts/smoke-agent.ts",
    "film:reveal": "node scripts/film-reveal.mjs",
    "listen:test": "node scripts/listen-test.mjs",
    "demo": "node scripts/demo.mjs",
    "e2e": "node scripts/e2e-tools.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.39",
    "@mapbox/vector-tile": "3.0.0",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-slot": "^1.1.1",
    "agora-agent-client-toolkit": "2.10.0",
    "agora-agent-uikit": "1.1.0",
    "agora-agents": "2.14.0",
    "agora-rtc-react": "^2.5.1",
    "agora-rtc-sdk-ng": "^4.24.3",
    "agora-rtm": "^2.2.3",
    "agora-token": "2.0.6",
    "ai": "^6.0.107",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.454.0",
    "next": "^16.2.6",
    "pbf": "5.2.0",
    "pmtiles": "4.5.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.10.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.2",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.6",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.58.1"
  },
  "overrides": {
    "agora-token": "$agora-token"
  }
}
