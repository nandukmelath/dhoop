# ── Agora (required) ─────────────────────────────────────────────────────────
# Agora Console → your project → "App ID"
NEXT_PUBLIC_AGORA_APP_ID=
# Agora Console → your project → "App Certificate". Server-side only.
NEXT_AGORA_APP_CERTIFICATE=
# Region of Agora's agent service: US (default, as in Agora's starter), AP or EU.
# AGORA_AREA=US

# ── Murf (required for the hackathon) ────────────────────────────────────────
# Murf API key for the Falcon voice. Without it Dhoop falls back to Agora's default voice.
MURF_API_KEY=
# One Murf Falcon voice for every language. Check Murf's voice library for voices that
# cover en-IN, hi-IN and kn-IN. Per-language overrides are optional.
# MURF_VOICE_ID=Jaya
# MURF_VOICE_ID_EN=
# MURF_VOICE_ID_HI=
# MURF_VOICE_ID_KN=
# MURF_BASE_URL=wss://global.api.murf.ai/v1/speech/stream-input

# ── Tools (required for the agent to act) ────────────────────────────────────
# Public HTTPS address of this app, because Agora's cloud calls the tools.
# A deployment URL or a tunnel URL, with no trailing slash. On Vercel this is detected.
PUBLIC_BASE_URL=
# Shared secret Agora sends with each tool call. Any long random string.
DHOOP_TOOL_SECRET=

# ── Optional ─────────────────────────────────────────────────────────────────
# 1 = two clearly labelled sample quotes arrive after a survey is sent (for solo runs).
# DHOOP_SAMPLE_QUOTES=0
# 1 = Agora's speaker lock, which follows the main speaker in a loud room.
# DHOOP_SPEAKER_LOCK=0
# Price per kW before subsidy used until a real quote arrives.
# DHOOP_COST_PER_KW=60000
# 1 = allow the /dev test page to call tools in a production build.
# DHOOP_DEV_TOOLS=0
# deepgram = use Agora-managed Deepgram for English sessions instead of Agora's own recognition.
# DHOOP_STT=ares
# 1 = log Agora API calls on the server.
# DHOOP_DEBUG=0
